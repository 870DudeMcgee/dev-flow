{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "devflow Review Result",
  "type": "object",
  "required": ["status", "summary", "findings", "required_actions", "confidence"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["approved", "changes_requested", "blocked"]
    },
    "summary": {
      "type": "string",
      "minLength": 5
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "category", "file", "message"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["blocking", "non_blocking"]
          },
          "category": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "suggested_fix": {
            "type": "string"
          }
        }
      }
    },
    "required_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "blocked_reason": {
      "type": "string"
    }
  }
}
