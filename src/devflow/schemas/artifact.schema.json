{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "devflow Artifact Metadata",
  "type": "object",
  "required": [
    "artifact_id",
    "artifact_type",
    "task_id",
    "role",
    "created_at",
    "repo_head",
    "input_hash",
    "output_hash",
    "body_path",
    "metadata_path",
    "parent_artifacts",
    "allowed_paths",
    "touched_paths",
    "verification_status",
    "apply_status",
    "metadata"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "pattern": "^art_[0-9]{14}_[a-f0-9]{4}$"
    },
    "artifact_type": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string"
    },
    "agent_profile": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "prompt_version": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "repo_head": {
      "type": "string"
    },
    "input_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "output_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "parent_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "touched_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "confidence": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "verification_status": {
      "type": "string",
      "enum": ["not_run", "passing", "failing", "blocked"]
    },
    "apply_status": {
      "type": "string",
      "enum": ["not_applied", "applied", "rolled_back", "blocked"]
    },
    "body_path": {
      "type": "string",
      "minLength": 1
    },
    "metadata_path": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object"
    }
  }
}
