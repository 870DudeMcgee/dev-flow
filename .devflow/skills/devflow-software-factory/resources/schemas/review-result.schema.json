{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Devflow Review Result",
  "description": "Schema for code review artifacts produced by the Devflow Software Factory workflow.",
  "type": "object",
  "required": ["status", "summary"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["approve", "changes_requested", "blocked"],
      "description": "Review verdict"
    },
    "blocking_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "issue": { "type": "string" }
        },
        "required": ["issue"]
      },
      "description": "Findings that block merge",
      "default": []
    },
    "non_blocking_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "suggestion": { "type": "string" }
        },
        "required": ["suggestion"]
      },
      "description": "Suggestions that do not block merge",
      "default": []
    },
    "verification_required": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Verification commands the reviewer recommends running",
      "default": []
    },
    "summary": {
      "type": "string",
      "description": "One-paragraph review summary"
    }
  },
  "additionalProperties": false
}
