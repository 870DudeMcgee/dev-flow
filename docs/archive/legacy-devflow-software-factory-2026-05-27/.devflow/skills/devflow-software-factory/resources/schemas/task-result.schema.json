{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Devflow Task Result",
  "description": "Schema for task completion artifacts produced by the Devflow Software Factory workflow.",
  "type": "object",
  "required": ["status", "summary", "changed_files", "verification"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["ready", "blocked", "needs_review"],
      "description": "Current task result status"
    },
    "summary": {
      "type": "string",
      "description": "One-paragraph description of what was done"
    },
    "changed_files": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of file paths that were modified"
    },
    "verification": {
      "type": "object",
      "required": ["commands", "status"],
      "properties": {
        "commands": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Verification commands that were run"
        },
        "status": {
          "type": "string",
          "enum": ["passed", "failed", "not_run"],
          "description": "Overall verification result"
        },
        "notes": {
          "type": "string",
          "description": "Optional detail about failures or skipped checks",
          "default": ""
        }
      },
      "additionalProperties": false
    },
    "risks": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Known risks or concerns",
      "default": []
    },
    "next_action": {
      "type": "string",
      "description": "Recommended follow-up action",
      "default": ""
    }
  },
  "additionalProperties": false
}
