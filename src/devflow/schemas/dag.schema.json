{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TaskDAG",
  "type": "object",
  "properties": {
    "goal_id": { "type": "string" },
    "status": { "type": "string" },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "string" },
          "depends_on": {
            "type": "array",
            "items": { "type": "string" }
          },
          "risk": { "type": "string" },
          "allowed_paths": {
            "type": "array",
            "items": { "type": "string" }
          },
          "verification": {
            "type": "array",
            "items": { "type": "string" }
          },
          "assigned_agent": { "type": "string" }
        },
        "required": ["id", "title"]
      }
    }
  },
  "required": ["goal_id", "tasks"]
}
