{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "devflow Repair Result",
  "type": "object",
  "required": ["status", "diff", "touched_paths", "risk", "confidence"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["ready", "blocked", "failed"]
    },
    "diff": {
      "type": "string"
    },
    "touched_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "blocked_reason": {
      "type": "string"
    }
  }
}
